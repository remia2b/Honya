            "value": "«Sistema» segue l'impostazione del tuo iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Systemowy” podąża za ustawieniem iPhone'a."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システムに従う」はiPhoneの設定に合わせます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Systeem’ volgt de instelling van je iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘시스템 설정’은 iPhone의 설정을 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「跟随系统」会依照 iPhone 的设置。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistem”, iPhone'unun ayarını izler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Как в системе» следует настройке вашего iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”System” följer inställningen på din iPhone."
          }
        }
      }
