    "Vous utilisez Honya sans compte : tout reste sur cet appareil.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're using Honya without an account: everything stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usas Honya sin cuenta: todo se queda en este dispositivo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usas Honya sin cuenta: todo se queda en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usa o Honya sem conta: tudo fica neste aparelho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt Honya ohne Account: Alles bleibt auf diesem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usi Honya senza account: tutto resta su questo dispositivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używasz Honya bez konta: wszystko zostaje na tym urządzeniu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなしでHonyaを使っています。すべてこの端末に残ります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gebruikt Honya zonder account: alles blijft op dit apparaat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이 Honya를 쓰고 있습니다. 모든 것은 이 기기에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在不使用账户的情况下使用 Honya：一切都留在本机。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Honya'yı hesapsız kullanıyorsun: her şey bu cihazda kalır."
