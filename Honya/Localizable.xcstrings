    "Comme dans Apple Books : quelques minutes par jour suffisent à construire une série.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like in Apple Books: a few minutes a day are enough to build a streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como en Apple Books: bastan unos minutos al día para construir una racha."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Como en Apple Books: bastan unos minutos al día para construir una racha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como no Apple Books: bastam alguns minutos por dia para formar uma sequência."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie in Apple Books: Ein paar Minuten am Tag genügen für eine Strähne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come in Apple Books: bastano pochi minuti al giorno per costruire una serie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak w Apple Books: kilka minut dziennie wystarczy, by zbudować serię."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleブックスと同じで、1日数分あれば記録は続きます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Net als in Apple Books: een paar minuten per dag zijn genoeg voor een reeks."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 도서처럼, 하루 몇 분이면 기록이 이어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就像 Apple 图书：每天几分钟就能连成记录。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Kitaplar'daki gibi: günde birkaç dakika bir seri kurmaya yeter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в Apple Books: нескольких минут в день достаточно, чтобы выстроить серию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Precis som i Apple Böcker: några minuter om dagen räcker för en rad."
          }
        }
      }
    },
