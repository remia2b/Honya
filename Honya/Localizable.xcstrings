    "Lisez chaque jour : la série grandit et les statistiques suivent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read every day: the streak grows and the statistics follow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee cada día: la racha crece y las estadísticas la siguen."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee cada día: la racha crece y las estadísticas la siguen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia todo dia: a sequência cresce e as estatísticas acompanham."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies jeden Tag: Die Strähne wächst, und die Statistik folgt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi ogni giorno: la serie cresce e le statistiche seguono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytaj codziennie: seria rośnie, a statystyki nadążają."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日読めば記録は伸び、統計もついてきます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees elke dag: de reeks groeit en de cijfers volgen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 읽으면 기록이 늘고 통계도 따라옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天阅读：记录会增长，统计也跟上。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün oku: seri büyür, istatistikler onu izler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читайте каждый день: серия растёт, а статистика следует за ней."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs varje dag: raden växer och statistiken följer med."
          }
        }
      }
