    "Ces étagères se remplissent toutes seules d'après vos statuts, vos notes et vos dates d'achat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These shelves fill themselves from your statuses, ratings and purchase dates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas estanterías se llenan solas según tus estados, valoraciones y fechas de compra."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos estantes se llenan solos según tus estados, calificaciones y fechas de compra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
