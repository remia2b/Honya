          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서점 직원이 매대를 차리는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书店店员正在摆台…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitapçı tezgâhı kuruyor…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Книготорговец раскладывает витрину…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokhandlaren dukar upp bordet…"
          }
        }
      }
    },
    "Le libraire qui range à votre place.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bookseller that shelves for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
