          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca, sessões, emblemas e estantes serão apagados. Não há volta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek, Sitzungen, Abzeichen und Regale werden gelöscht. Ohne Rückweg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria, le sessioni, i distintivi e gli scaffali saranno cancellati. Senza ritorno."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja biblioteka, sesje, odznaki i półki zostaną usunięte. Bez odwrotu."
