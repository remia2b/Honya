    "Le code-barres au dos du livre suffit : titre, couverture et pages arrivent tout seuls, tome après tome.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The barcode on the back is enough: title, cover and page count arrive on their own, volume after volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta el código de barras de la contraportada: título, portada y páginas llegan solos, tomo tras tomo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta el código de barras de la contratapa: título, portada y páginas llegan solos, tomo tras tomo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código de barras da contracapa basta: título, capa e páginas chegam sozinhos, volume após volume."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Strichcode auf der Rückseite genügt: Titel, Cover und Seitenzahl kommen von selbst, Band für Band."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta il codice a barre sul retro: titolo, copertina e pagine arrivano da soli, volume dopo volume."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy kod kreskowy z tyłu: tytuł, okładka i liczba stron pojawią się same, tom po tomie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "裏表紙のバーコードだけで十分。タイトル・表紙・ページ数が一巻ずつ自動で揃います。"
          }
        }
      }
    },
