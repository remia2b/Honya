    "Un joker par semaine protège votre série de lecture : une soirée ratée ne brûle pas 40 jours d'effort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One free pass a week protects your streak: a missed evening doesn't burn 40 days of effort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comodín por semana protege tu racha: una noche perdida no quema 40 días de esfuerzo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comodín por semana protege tu racha: una noche perdida no quema 40 días de esfuerzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um coringa por semana protege sua sequência: uma noite perdida não queima 40 dias de esforço."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Joker pro Woche schützt deine Strähne: ein verpasster Abend verbrennt nicht 40 Tage Mühe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jolly a settimana protegge la tua serie: una sera saltata non brucia 40 giorni di impegno."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden joker w tygodniu chroni Twoją serię: jeden opuszczony wieczór nie spali 40 dni starań."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週に一度のジョーカーが連続記録を守ります。一晩逃しても40日の積み重ねは消えません。"
          }
        }
      }
    },
