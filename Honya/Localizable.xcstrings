          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde aqui as frases que fizeram você parar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre hier die Sätze auf, bei denen du innegehalten hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva qui le frasi che ti hanno fermato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbieraj tu zdania, przy których się zatrzymałeś."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思わず手が止まった一文を、ここに残しましょう。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar hier de zinnen waarbij je bleef hangen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음이 멈춘 문장을 여기에 남기세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把让你停下来的句子留在这里。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni durduran cümleleri burada sakla."
          }
