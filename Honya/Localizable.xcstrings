            "value": "Scanne eine ISBN oder suche einen Titel, um dein erstes Buch ins Regal zu stellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona un ISBN o cerca un titolo per mettere il tuo primo libro sullo scaffale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj ISBN albo wyszukaj tytuł, żeby postawić pierwszą książkę na półce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ISBNをスキャンするかタイトルを検索して、最初の一冊を本棚に置きましょう。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan een ISBN of zoek een titel om je eerste boek op de plank te zetten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ISBN을 스캔하거나 제목을 검색해 첫 책을 책장에 올려 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 ISBN 或搜索书名，把第一本书放上书架。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk kitabını rafa koymak için bir ISBN tara ya da bir başlık ara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте ISBN или найдите название, чтобы поставить первую книгу на полку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
