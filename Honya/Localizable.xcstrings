    "Modifiable à tout moment dans les réglages. Un joker par semaine protège votre série.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changeable at any time in Settings. One free pass a week protects your streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificable en cualquier momento en Ajustes. Un comodín por semana protege tu racha."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificable en cualquier momento en Configuración. Un comodín por semana protege tu racha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterável a qualquer momento nos Ajustes. Um coringa por semana protege sua sequência."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jederzeit in den Einstellungen änderbar. Ein Joker pro Woche schützt deine Strähne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificabile in qualsiasi momento nelle Impostazioni. Un jolly a settimana protegge la tua serie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można zmienić w każdej chwili w Ustawieniach. Jeden joker w tygodniu chroni Twoją serię."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定からいつでも変更できます。週に一度のジョーカーが連続記録を守ります。"
          }
        }
      }
    },
