    "Cinq citations gardées, et celles-ci restent à vous pour toujours. Honya+ enlève le compteur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five quotes saved, and they stay yours forever. Honya+ removes the limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco citas guardadas, y son tuyas para siempre. Honya+ elimina el contador."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco citas guardadas, y son tuyas para siempre. Honya+ elimina el límite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco citações guardadas, e elas continuam suas para sempre. O Honya+ remove o limite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Zitate gespeichert, und diese gehören für immer dir. Honya+ entfernt das Limit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinque citazioni salvate, e restano tue per sempre. Honya+ toglie il contatore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijf bewaarde citaten, en die blijven voor altijd van jou. Honya+ haalt de teller weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pięć zapisanych cytatów zostaje z Tobą na zawsze. Honya+ zdejmuje limit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem sparade citat, och de förblir dina för alltid. Honya+ tar bort gränsen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş alıntı kaydedildi ve bunlar sonsuza dek senin. Honya+ sayacı kaldırır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять сохранённых цитат останутся с вами навсегда. Honya+ убирает счётчик."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した5つの引用はずっと残ります。Honya+なら上限なしで記録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록해 둔 문장 5개는 평생 간직할 수 있어요. Honya+는 개수 제한을 없애드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 5 条摘录，它们将永远属于你。Honya+ 解锁数量限制。"
          }
        }
      }
    },
