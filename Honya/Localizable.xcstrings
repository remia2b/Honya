    "Modifiable à tout moment dans les réglages. Un joker par semaine protège votre série.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changeable at any time in Settings. One free pass a week protects your streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificable en cualquier momento en Ajustes. Un comodín por semana protege tu racha."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificable en cualquier momento en Configuración. Un comodín por semana protege tu racha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterável a qualquer momento nos Ajustes. Um coringa por semana protege sua sequência."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jederzeit in den Einstellungen änderbar. Ein Joker pro Woche schützt deine Strähne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificabile in qualsiasi momento nelle Impostazioni. Un jolly a settimana protegge la tua serie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można zmienić w każdej chwili w Ustawieniach. Jeden joker w tygodniu chroni Twoją serię."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定からいつでも変更できます。週に一度のジョーカーが連続記録を守ります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd te wijzigen in Instellingen. Eén joker per week beschermt je reeks."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 언제든 바꿀 수 있습니다. 주에 한 번의 면제가 기록을 지켜 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可在设置中修改。每周一次的豁免会保护你的连续记录。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlardan istediğin zaman değiştirilebilir. Haftada bir joker serini korur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно изменить в любой момент в настройках. Один джокер в неделю бережёт серию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ändras när som helst i Inställningar. En joker i veckan skyddar din rad."
          }
        }
      }
    },
