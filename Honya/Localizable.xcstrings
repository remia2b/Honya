    "Les tomes 1 à %lld seront marqués comme lus — et donc possédés.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes 1 to %lld will be marked read — and therefore owned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tomos 1 a %lld se marcarán como leídos, y por tanto en tu estantería."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tomos 1 a %lld se marcarán como leídos, y por lo tanto en tu estantería."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os volumes 1 a %lld serão marcados como lidos — e portanto na estante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bände 1 bis %lld gelten als gelesen — und damit als vorhanden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I volumi da 1 a %lld saranno segnati come letti, e quindi posseduti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomy od 1 do %lld zostaną oznaczone jako przeczytane — a więc i posiadane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1巻から%lld巻までを読了（したがって所有）にします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel 1 tot %lld worden als gelezen gemarkeerd — en dus als in bezit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1권부터 %lld권까지 읽음(따라서 소장)으로 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第1卷至第%lld卷将标为已读，因此也算已拥有。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ciltten %lld. cilde kadar okundu — dolayısıyla rafta — sayılacak."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тома с 1 по %lld будут отмечены прочитанными — и значит, имеющимися."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Del 1 till %lld markeras som lästa — och därmed som ägda."
          }
        }
      }
    },
    "Les tomes 1 à %lld seront marqués comme possédés. Les suivants passent en manquants.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes 1 to %lld will be marked owned. The rest become missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tomos 1 a %lld pasarán a tu estantería. Los siguientes quedarán como faltantes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tomos 1 a %lld pasarán a tu estantería. Los siguientes quedarán como faltantes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os volumes 1 a %lld irão para a estante. Os seguintes ficam como faltantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bände 1 bis %lld stehen im Regal. Die folgenden gelten als fehlend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I volumi da 1 a %lld saranno posseduti. I successivi diventano mancanti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomy od 1 do %lld trafią na półkę. Kolejne zostaną oznaczone jako brakujące."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1巻から%lld巻までを所有にします。それ以降は未所持になります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel 1 tot %lld komen in de kast. De rest wordt als ontbrekend gemarkeerd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1권부터 %lld권까지 소장으로 표시하고, 이후는 미소장이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第1卷至第%lld卷标为已拥有，其余标为缺少。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ciltten %lld. cilde kadar rafta sayılacak. Sonrakiler eksik olacak."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тома с 1 по %lld будут отмечены имеющимися. Остальные — недостающими."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Del 1 till %lld hamnar i hyllan. Resten markeras som saknade."
          }
        }
      }
    },
