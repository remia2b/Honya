    "Votre premier tour n'a rien donné. Celui-ci est le bon.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first spin came up empty. This one is the charm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu primera tirada no dio nada. Esta es la buena."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu primer giro no tuvo suerte. Este es el bueno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu primeiro giro não deu em nada. Desta vez vai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erster Dreh war nichts. Dieser hier zählt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo primo giro non ha dato nulla. Questo è quello giusto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste draai leverde niets op. Deze keer is het raak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwszy obrót nic nie dał. Ten będzie szczęśliwy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första snurret gav inget. Nu har du turen med dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk çevirişinde bir şey çıkmadı. Bu sefer olacak."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В первый раз не повезло. Сейчас точно получится."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初ははずれでした。今度こそ当たりです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째는 아쉽게 빗나갔네요. 이번엔 분명 나올 거예요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次没有转中。这一次准行。"
          }
        }
      }
    },
