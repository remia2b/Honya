    "Lisez chaque jour : la série grandit et les statistiques suivent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read every day: the streak grows and the statistics follow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee cada día: la racha crece y las estadísticas la siguen."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee cada día: la racha crece y las estadísticas la siguen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia todo dia: a sequência cresce e as estatísticas acompanham."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies jeden Tag: Die Strähne wächst, und die Statistik folgt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi ogni giorno: la serie cresce e le statistiche seguono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytaj codziennie: seria rośnie, a statystyki nadążają."
