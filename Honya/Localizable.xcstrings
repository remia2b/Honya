          "stringUnit": {
            "state": "translated",
            "value": "十二月的完整年度回顾"
          }
        }
      }
    },
    "La synchronisation iCloud (CloudKit) arrive dans une prochaine version — vos données restent à vous.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync (CloudKit) is coming in a future version — your data stays yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud (CloudKit) llegará en una próxima versión: tus datos siguen siendo tuyos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud (CloudKit) llegará en una próxima versión: tus datos siguen siendo tuyos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com iCloud (CloudKit) chega numa próxima versão — seus dados continuam seus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung (CloudKit) kommt in einer späteren Version — deine Daten bleiben deine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione iCloud (CloudKit) arriverà in una prossima versione: i tuoi dati restano tuoi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja z iCloud (CloudKit) pojawi się w kolejnej wersji — Twoje dane pozostają Twoje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期（CloudKit）は今後のバージョンで対応予定です。データはあなたのものです。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synchronisatie (CloudKit) komt in een volgende versie — je gegevens blijven van jou."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화(CloudKit)는 다음 버전에서 지원합니다. 데이터는 당신의 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步（CloudKit）将在后续版本推出 — 你的数据始终属于你。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud eşitlemesi (CloudKit) sonraki bir sürümde gelecek — verilerin senin kalır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация с iCloud (CloudKit) появится в следующей версии — ваши данные остаются вашими."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synk (CloudKit) kommer i en kommande version — dina data förblir dina."
          }
        }
      }
    },
    "Lancez une session depuis l'accueil : minutes, pages et records se mesurent tout seuls.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a session from Today: minutes, pages and records measure themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza una sesión desde Hoy: minutos, páginas y récords se miden solos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza una sesión desde Hoy: minutos, páginas y récords se miden solos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma sessão em Hoje: minutos, páginas e recordes se medem sozinhos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte eine Sitzung unter „Heute“: Minuten, Seiten und Rekorde messen sich von selbst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una sessione da Oggi: minuti, pagine e record si misurano da soli."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij sesję z ekranu Dziś: minuty, strony i rekordy liczą się same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日」からセッションを始めれば、分数もページも記録も自動で計測されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start een sessie vanaf Vandaag: minuten, pagina's en records meten zichzelf."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘오늘’에서 세션을 시작하면 분·페이지·기록이 저절로 측정됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从「今天」开始一次阅读：分钟、页数和纪录都会自动统计。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün ekranından bir oturum başlat: dakikalar, sayfalar ve rekorlar kendiliğinden ölçülür."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните сеанс с экрана «Сегодня»: минуты, страницы и рекорды считаются сами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta ett pass från I dag: minuter, sidor och rekord mäts av sig själva."
          }
        }
      }
    },
