            "state": "translated",
            "value": "Danach 29,99 €/Jahr. Jederzeit kündbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi 29,99 €/anno. Annullabile in qualsiasi momento."
          }
        },
