      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library, alive.\nWhat are you reading?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca, viva.\n¿Qué estás leyendo?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca, viva.\n¿Qué estás leyendo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca, viva.\nO que você está lendo?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek, lebendig.\nWas liest du gerade?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria, viva.\nCosa stai leggendo?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja biblioteka, żywa.\nCo czytasz?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生きているライブラリ。\n今なにを読んでいますか？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bibliotheek, levend.\nWat lees je?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "살아 있는 서재.\n무엇을 읽고 있나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让书库活起来。\n你在读什么？"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığın, canlı.\nNe okuyorsun?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша библиотека — живая.\nЧто вы читаете?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt bibliotek, levande.\nVad läser du?"
          }
        }
      }
    },
    "Votre bibliothèque, vos sessions, vos badges et vos étagères seront effacés. C'est sans retour.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library, sessions, badges and shelves will be erased. There's no going back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca, tus sesiones, tus insignias y tus estanterías se borrarán. No hay vuelta atrás."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca, tus sesiones, tus insignias y tus estantes se borrarán. No hay vuelta atrás."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca, sessões, emblemas e estantes serão apagados. Não há volta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek, Sitzungen, Abzeichen und Regale werden gelöscht. Ohne Rückweg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria, le sessioni, i distintivi e gli scaffali saranno cancellati. Senza ritorno."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja biblioteka, sesje, odznaki i półki zostaną usunięte. Bez odwrotu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ・セッション・バッジ・本棚がすべて消えます。取り消せません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bibliotheek, sessies, badges en planken worden gewist. Zonder weg terug."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서재·세션·배지·책장이 모두 지워집니다. 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的书库、阅读记录、徽章和书架都会被清除，无法恢复。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığın, oturumların, rozetlerin ve rafların silinecek. Geri dönüşü yok."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша библиотека, сеансы, значки и полки будут стёрты. Без возврата."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt bibliotek, dina pass, märken och hyllor raderas. Ingen väg tillbaka."
          }
        }
      }
    },
