    "Ajoutez des envies depuis la recherche.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the ones you want from Search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tus antojos desde la búsqueda."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega tus antojos desde la búsqueda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione seus desejos pela busca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Wünsche über die Suche hinzu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i tuoi desideri dalla ricerca."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj to, na co masz ochotę, przez wyszukiwarkę."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索から欲しい本を追加しましょう。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg vanuit Zoeken toe wat je wilt hebben."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색에서 갖고 싶은 책을 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从搜索里添加你想要的书。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediklerini aramadan ekle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте желаемое из поиска."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till det du vill ha från Sök."
          }
        }
      }
    },
