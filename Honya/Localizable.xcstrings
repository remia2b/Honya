    "Tous les tomes parus et à venir, dates comprises.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every volume out and upcoming, release dates included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los tomos publicados y por venir, con sus fechas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los tomos publicados y por salir, con sus fechas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os volumes lançados e futuros, com as datas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle erschienenen und kommenden Bände, mit Terminen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i volumi usciti e in arrivo, date comprese."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verschenen en komende delen, met datums."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie wydane i nadchodzące tomy, z datami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla utgivna och kommande volymer, med datum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkmış ve çıkacak tüm ciltler, tarihleriyle birlikte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все вышедшие и будущие тома, с датами выхода."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既刊も新刊も、発売日つきで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출간된 권도 나올 권도, 발매일까지."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
