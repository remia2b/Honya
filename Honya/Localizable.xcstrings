            "value": "そのうち開こうと思っている本。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De boeken die je binnenkort wilt opslaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧 펼치려는 책들."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打算很快翻开的书。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakında açmayı düşündüğün kitaplar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Книги, которые вы собираетесь скоро открыть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Böckerna du tänker öppna snart."
          }
        }
      }
    },
    "Les livres reconnus apparaîtront ici, prêts à rejoindre la bibliothèque.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognised books appear here, ready to join your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los libros reconocidos aparecerán aquí, listos para tu biblioteca."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los libros reconocidos aparecerán aquí, listos para tu biblioteca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os livros reconhecidos aparecem aqui, prontos para a biblioteca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkannte Bücher erscheinen hier, bereit für deine Bibliothek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I libri riconosciuti appaiono qui, pronti per la libreria."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznane książki pojawią się tutaj, gotowe do biblioteki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識した本がここに並び、ライブラリに追加できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkende boeken verschijnen hier, klaar voor je bibliotheek."
