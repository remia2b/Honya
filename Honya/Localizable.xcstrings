    "Rien n'est partagé, et votre compte s'efface d'un bouton.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is shared, and your account is one button away from being gone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se comparte nada, y tu cuenta se borra con un botón."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se comparte nada, y tu cuenta se borra con un botón."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é compartilhado, e sua conta some com um botão."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird geteilt, und dein Account ist mit einem Knopf gelöscht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene condiviso, e il tuo account si cancella con un pulsante."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest udostępniane, a konto usuwasz jednym przyciskiem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も共有されません。アカウントはボタンひとつで消せます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets gedeeld, en je account is met één knop weg."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 공유되지 않으며, 계정은 버튼 하나로 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么都不会被分享，账户一键即可删除。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey paylaşılmaz ve hesabın tek düğmeyle silinir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не передаётся, а учётная запись удаляется одной кнопкой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget delas, och ditt konto försvinner med en knapptryckning."
          }
        }
      }
