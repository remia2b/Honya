          "stringUnit": {
            "state": "translated",
            "value": "Daarna 29,99 €/jaar. Op elk moment opzegbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem 29,99 €/rok. Możesz anulować w każdej chwili."
