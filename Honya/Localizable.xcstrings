        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы пользуетесь Honya без учётной записи: всё остаётся на этом устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du använder Honya utan konto: allt stannar på den här enheten."
          }
        }
      }
    },
