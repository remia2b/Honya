    "Les genres apparaîtront avec vos premiers ajouts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Genres appear as soon as you add your first books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los géneros aparecerán con tus primeras incorporaciones."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los géneros aparecerán con tus primeras incorporaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
