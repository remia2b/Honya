    "Votre bibliothèque, vos sessions, vos badges et vos étagères seront effacés. C'est sans retour.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library, sessions, badges and shelves will be erased. There's no going back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca, tus sesiones, tus insignias y tus estanterías se borrarán. No hay vuelta atrás."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
