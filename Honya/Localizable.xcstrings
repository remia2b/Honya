    "Ajoutez un tome, la série entière apparaît — dates de sortie comprises.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add one volume and the whole series appears — release dates included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un tomo y aparece la serie entera, fechas de publicación incluidas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un tomo y aparece la serie entera, fechas de publicación incluidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um volume e a série inteira aparece — datas de lançamento incluídas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Band hinzu, und die ganze Reihe erscheint — samt Erscheinungsdaten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un volume e appare l'intera serie, date di uscita comprese."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj jeden tom, a pojawi się cała seria — razem z datami premier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一巻を追加すればシリーズ全体が並びます。発売日も含めて。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg één deel toe en de hele reeks verschijnt — inclusief verschijningsdata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 권만 추가하면 시리즈 전체가, 발매일까지 함께 나타납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要添加一卷，整个系列就会出现 — 连发行日期也一并带上。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir cilt ekle, tüm seri belirir — çıkış tarihleriyle birlikte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте один том — появится вся серия, вместе с датами выхода."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en del så dyker hela serien upp — utgivningsdatum inkluderade."
          }
        }
      }
    },
