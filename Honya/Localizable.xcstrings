    "Métadonnées : Google Books, Open Library, AniList. Les couvertures restent la propriété de leurs éditeurs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata: Google Books, Open Library, AniList. Covers remain the property of their publishers."
          }
        },
        "es": {
          "stringUnit": {
