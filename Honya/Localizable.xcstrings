    "Vos lectures restent sur votre appareil. Vous pouvez supprimer votre compte à tout moment depuis les réglages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your reading stays on your device. You can delete your account at any time from Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus lecturas se quedan en tu dispositivo. Puedes eliminar tu cuenta cuando quieras desde Ajustes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus lecturas se quedan en tu dispositivo. Puedes eliminar tu cuenta cuando quieras desde Configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas leituras ficam no seu aparelho. Você pode excluir sua conta quando quiser nos Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lektüre bleibt auf deinem Gerät. Du kannst deinen Account jederzeit in den Einstellungen löschen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue letture restano sul tuo dispositivo. Puoi eliminare l'account quando vuoi dalle Impostazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje lektury zostają na urządzeniu. Konto możesz usunąć w każdej chwili w Ustawieniach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読書の記録は端末に残ります。アカウントは設定からいつでも削除できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je leesgegevens blijven op je apparaat. Je kunt je account altijd verwijderen in Instellingen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독서 기록은 기기에 남습니다. 계정은 설정에서 언제든 삭제할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的阅读记录留在设备上。你可以随时在设置中删除账户。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okumaların cihazında kalır. Hesabını istediğin zaman Ayarlar'dan silebilirsin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши записи о чтении остаются на устройстве. Учётную запись можно удалить в любой момент в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din läsning stannar på din enhet. Du kan radera ditt konto när som helst i Inställningar."
          }
        }
      }
    },
