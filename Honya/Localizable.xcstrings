    "Vos lectures restent sur votre appareil. Vous pouvez supprimer votre compte à tout moment depuis les réglages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your reading stays on your device. You can delete your account at any time from Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus lecturas se quedan en tu dispositivo. Puedes eliminar tu cuenta cuando quieras desde Ajustes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus lecturas se quedan en tu dispositivo. Puedes eliminar tu cuenta cuando quieras desde Configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas leituras ficam no seu aparelho. Você pode excluir sua conta quando quiser nos Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lektüre bleibt auf deinem Gerät. Du kannst deinen Account jederzeit in den Einstellungen löschen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue letture restano sul tuo dispositivo. Puoi eliminare l'account quando vuoi dalle Impostazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje lektury zostają na urządzeniu. Konto możesz usunąć w każdej chwili w Ustawieniach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読書の記録は端末に残ります。アカウントは設定からいつでも削除できます。"
          }
        }
      }
    },
    "Votre année de lecture en cartes partageables — rendez-vous en décembre.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your reading year as shareable cards — see you in December."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu año de lectura en tarjetas para compartir: nos vemos en diciembre."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu año de lectura en tarjetas para compartir: nos vemos en diciembre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ano de leitura em cartões para compartilhar — até dezembro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Lesejahr als teilbare Karten — wir sehen uns im Dezember."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo anno di letture in schede da condividere: ci vediamo a dicembre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój rok czytania w kartach do udostępnienia — do zobaczenia w grudniu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一年の読書をシェアできるカードに。12月にお会いしましょう。"
          }
        }
      }
    },
    "Votre bibliothèque, vivante.\nQue lisez-vous ?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library, alive.\nWhat are you reading?"
          }
