    "Celui-ci est le bon. Faites-la tourner.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one's the one. Give it a spin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el bueno. Hazla girar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el bueno. Hazla girar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a boa. Gire a roda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser ist der richtige. Dreh sie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è quello buono. Falla girare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze is de goede. Draai maar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten będzie ten. Zakręć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är rätt. Snurra på."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sefer tuttu. Çevir bakalım."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот этот — тот самый. Крутите."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが当たり。回してみて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번이 그 순간이에요. 돌려 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就是这一次，转吧。"
          }
        }
      }
    },
    "Ces étagères se remplissent toutes seules d'après vos statuts, vos notes et vos dates d'achat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These shelves fill themselves from your statuses, ratings and purchase dates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas estanterías se llenan solas según tus estados, valoraciones y fechas de compra."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos estantes se llenan solos según tus estados, calificaciones y fechas de compra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas estantes se enchem sozinhas a partir dos seus status, avaliações e datas de compra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Regale füllen sich von selbst — nach Status, Bewertung und Kaufdatum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi scaffali si riempiono da soli in base a stati, voti e date d'acquisto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te półki zapełniają się same — na podstawie statusów, ocen i dat zakupu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの本棚は、ステータス・評価・購入日から自動で埋まります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze planken vullen zichzelf op basis van je statussen, beoordelingen en aankoopdata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 책장들은 상태·평점·구매일을 바탕으로 저절로 채워집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些书架会依据你的状态、评分和购买日期自动填充。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu raflar durumlarına, puanlarına ve satın alma tarihlerine göre kendiliğinden dolar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти полки заполняются сами — по вашим статусам, оценкам и датам покупки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här hyllorna fyller sig själva utifrån dina statusar, betyg och inköpsdatum."
          }
        }
      }
    },
