          }
        }
      }
    },
    "Les livres reconnus apparaîtront ici, prêts à rejoindre la bibliothèque.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognised books appear here, ready to join your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los libros reconocidos aparecerán aquí, listos para tu biblioteca."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los libros reconocidos aparecerán aquí, listos para tu biblioteca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os livros reconhecidos aparecem aqui, prontos para a biblioteca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkannte Bücher erscheinen hier, bereit für deine Bibliothek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I libri riconosciuti appaiono qui, pronti per la libreria."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznane książki pojawią się tutaj, gotowe do biblioteki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識した本がここに並び、ライブラリに追加できます。"
          }
        }
      }
    },
    "Les tomes 1 à %lld seront marqués comme lus — et donc possédés.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes 1 to %lld will be marked read — and therefore owned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tomos 1 a %lld se marcarán como leídos, y por tanto en tu estantería."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tomos 1 a %lld se marcarán como leídos, y por lo tanto en tu estantería."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os volumes 1 a %lld serão marcados como lidos — e portanto na estante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bände 1 bis %lld gelten als gelesen — und damit als vorhanden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I volumi da 1 a %lld saranno segnati come letti, e quindi posseduti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomy od 1 do %lld zostaną oznaczone jako przeczytane — a więc i posiadane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1巻から%lld巻までを読了（したがって所有）にします。"
          }
        }
      }
    },
    "Les tomes 1 à %lld seront marqués comme possédés. Les suivants passent en manquants.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes 1 to %lld will be marked owned. The rest become missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tomos 1 a %lld pasarán a tu estantería. Los siguientes quedarán como faltantes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tomos 1 a %lld pasarán a tu estantería. Los siguientes quedarán como faltantes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os volumes 1 a %lld irão para a estante. Os seguintes ficam como faltantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bände 1 bis %lld stehen im Regal. Die folgenden gelten als fehlend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I volumi da 1 a %lld saranno posseduti. I successivi diventano mancanti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomy od 1 do %lld trafią na półkę. Kolejne zostaną oznaczone jako brakujące."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1巻から%lld巻までを所有にします。それ以降は未所持になります。"
          }
        }
      }
    },
    "Lire avant 7 h, 5 fois": {
