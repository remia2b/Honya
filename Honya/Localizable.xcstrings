    "Au lieu de 29,99 €. Se renouvelle ensuite au tarif normal, résiliable à tout moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of €29.99. Then renews at regular price, cancel anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugar de 29,99 €. Después se renueva a la tarifa normal, cancelable en cualquier momento."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugar de 29,99 €. Luego se renueva a la tarifa normal, cancela cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de 29,99 €. Renovação pelo valor normal, cancele quando quiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt 29,99 €. Verlängert sich danach zum Normalpreis, jederzeit kündbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invece di 29,99 €. Poi si rinnova alla tariffa normale, annullabile in qualsiasi momento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In plaats van 29,99 €. Verlengt daarna tegen het normale tarief, op elk moment opzegbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiast 29,99 €. Potem odnawia się w standardowej cenie, możesz anulować w każdej chwili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I stället för 29,99 €. Förnyas sedan till ordinarie pris, kan avslutas när som helst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "29,99 € yerine. Sonrasında standart fiyattan yenilenir, dilediğin zaman iptal edilebilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо 29,99 €. Затем по обычной цене, отмена в любой момент."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常29.99 €。以降は通常価格で更新、いつでも解約可能。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "29,99 € 대신 특별가. 이후 정상가로 갱신되며 언제든 해지 가능합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原价 29.99 €。之后按原价续订，可随时取消。"
          }
        }
      }
    },
