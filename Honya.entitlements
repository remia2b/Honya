<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Password AutoFill : l'app est du meme monde que honya.app. Sans
	     cette association, iOS re-negocie AutoFill a chaque changement de
	     champ et reconstruit le clavier - le clignotement du journal.
	     Le www est l'hote qui sert le fichier d'association ; l'apex y
	     redirige. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:www.honya.app</string>
		<string>webcredentials:honya.app</string>
		<!-- Le lien de confirmation du courrier ouvre l'application, pas le
		     site : c'est applinks qui le permet. Les chemins sont limites a
		     la page de confirmation dans le fichier d'association. -->
		<string>applinks:www.honya.app</string>
		<string>applinks:honya.app</string>
	</array>
</dict>
</plist>
